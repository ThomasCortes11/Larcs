# Copia este archivo a .env.local y reemplaza los valores de ejemplo.
# Nunca subas .env.local ni .env.production al repositorio.

# WhatsApp público de la tienda, solo dígitos con indicativo de país.
NEXT_PUBLIC_WHATSAPP_NUMBER=57XXXXXXXXXX

# Wompi. Déjalas vacías mientras la pasarela esté en preparación.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_REDIRECT_URL=
